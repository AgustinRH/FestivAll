# Copiar a .env en la raíz: cp .env.example .env
# Nunca commits .env / *.env

# Puerto web (nginx) en el host
APP_PORT=80

# MariaDB
DB_PASSWORD=change-me
DB_DATABASE=FestivAll

# JWT (obligatorio en producción)
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=7d

# Stripe — test | live
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=sk_test_change_me
STRIPE_WEBHOOK_SECRET_TEST=whsec_change_me
STRIPE_TAX_RATE_ID_TEST=txr_change_me
STRIPE_SECRET_KEY_LIVE=sk_live_change_me
STRIPE_WEBHOOK_SECRET_LIVE=whsec_change_me
STRIPE_TAX_RATE_ID_LIVE=txr_change_me
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_TAX_RATE_ID=txr_change_me

FESTIVALL_COMMISSION_PERCENT=10
STRIPE_FEE_PERCENT=1.5
STRIPE_FEE_FIXED_EUR=0.25

FRONTEND_URL=http://localhost
# FRONTEND_URL=http://localhost:4200
# FRONTEND_URL=https://example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=change-me
MAIL_FROM=noreply@example.com
