# Copiar a .env en la raíz: cp .env.example .env
# Docker Compose carga este archivo Y backend/.env en el servicio API.
# Si la misma variable está en ambos, gana backend/.env (se carga después).

# Puerto web (nginx) en el host
APP_PORT=80

# MariaDB
DB_PASSWORD=REDACTED
DB_DATABASE=FestivAll

# JWT (cambiar en producción)
JWT_SECRET=un_secreto_largo_y_aleatorio_aqui
JWT_EXPIRES_IN=7d

# Stripe — test | live (alterna sin tocar código)
STRIPE_MODE=test
# Claves por modo (recomendado). Si faltan, se usa STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY_TEST=sk_test_
STRIPE_WEBHOOK_SECRET_TEST=whsec_
STRIPE_TAX_RATE_ID_TEST=txr_
STRIPE_SECRET_KEY_LIVE=sk_live_
STRIPE_WEBHOOK_SECRET_LIVE=whsec_
STRIPE_TAX_RATE_ID_LIVE=txr_
# Legacy (una sola clave; debe coincidir con STRIPE_MODE)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_TAX_RATE_ID=txr_
# Liquidación cierre de caja (estimaciones)
FESTIVALL_COMMISSION_PERCENT=10
STRIPE_FEE_PERCENT=1.5
STRIPE_FEE_FIXED_EUR=0.25
# URL pública del frontend (redirección tras pagar en Stripe Checkout)
# Docker en local:
FRONTEND_URL=http://localhost
# Desarrollo con ng serve:
# FRONTEND_URL=http://localhost:4200
# Producción:
# FRONTEND_URL=https://tu-dominio.com

# SMTP — Porkbun (correo del dominio, ej. info@festivall.club)
# Panel: porkbun.com → dominio → Email → contraseña del buzón
# Docs: https://kb.porkbun.com/article/146-email-client-configuration-settings
SMTP_HOST=smtp.porkbun.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@festivall.club
SMTP_PASS=
MAIL_FROM=info@festivall.club
