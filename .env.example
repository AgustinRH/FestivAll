# Copiar a .env en la raíz: cp .env.example .env
# Docker Compose carga este archivo Y backend/.env en el servicio API.
# Si la misma variable está en ambos, gana backend/.env (se carga después).

# Puerto web (nginx) en el host
APP_PORT=80

# MariaDB
DB_PASSWORD=REDACTED
DB_DATABASE=FestivAll

# JWT (cambiar en producción)
JWT_SECRET=un_secreto_largo_y_aleatorio_aqui
JWT_EXPIRES_IN=7d

# Stripe — puedes definirlas aquí (Docker) o solo en backend/.env (desarrollo local)
# Modo test: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# URL pública del frontend (redirección tras pagar en Stripe Checkout)
# Docker en local:
FRONTEND_URL=http://localhost
# Desarrollo con ng serve:
# FRONTEND_URL=http://localhost:4200
# Producción:
# FRONTEND_URL=https://tu-dominio.com
